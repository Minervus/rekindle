# Postgres connection string. Provision one locally (e.g. `createdb rekindle`
# or Docker) and run `npm run db:push` after setting this to create the tables.
DATABASE_URL=

# Anthropic API key — from console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5 if unset — this app's suggestion
# generation is a short drafting task well suited to haiku-tier. Swap to
# claude-sonnet-5 or claude-opus-5 for higher-quality but pricier generations.
ANTHROPIC_MODEL=claude-haiku-4-5

# Long random string used to sign login JWTs. Generate with:
#   openssl rand -base64 32
JWT_SECRET=

# bcrypt hash of your single login passphrase. Generate with:
#   npm run hash-passphrase -- "your-passphrase"
AUTH_PASSPHRASE_HASH=
